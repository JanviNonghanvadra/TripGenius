@model TripGenius.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="tg-auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
            <div class="col-md-6">
                <div class="card p-4 shadow-sm">

                    <h3 class="mb-2">Reset your password</h3>
                    <p class="text-muted">Enter your new password below.</p>

                    <form asp-action="ResetPassword" method="post" id="resetForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Hidden fields -->
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <!-- Validation summary -->
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- New Password -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Enter new password"
                                   required />

                            <div class="invalid-feedback">
                                Password must be at least 6 characters.
                            </div>

                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Confirm password"
                                   required />

                            <div class="invalid-feedback">
                                Passwords do not match.
                            </div>

                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <button class="btn btn-primary w-100" type="submit" id="resetBtn">
                            Update Password
                        </button>

                        <!-- Back -->
                        <div class="text-center mt-3">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-link">
                                Back to Sign In
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('resetForm');
            if (!form) return;

            var newPassword = document.getElementById('NewPassword');
            var confirmPassword = document.getElementById('ConfirmPassword');
            var btn = document.getElementById('resetBtn');

            form.addEventListener('submit', function (e) {

                // Check required + length
                if (!newPassword.value || newPassword.value.length < 6) {
                    e.preventDefault();
                    newPassword.classList.add('is-invalid');
                    return;
                }

                // Check match
                if (newPassword.value !== confirmPassword.value) {
                    e.preventDefault();
                    confirmPassword.classList.add('is-invalid');
                    return;
                }

                // Prevent double submit
                btn.disabled = true;
                btn.innerHTML = "Updating...";
            });

            newPassword.addEventListener('input', function () {
                newPassword.classList.remove('is-invalid');
            });

            confirmPassword.addEventListener('input', function () {
                confirmPassword.classList.remove('is-invalid');
            });
        })();
    </script>
}