@{
    ViewData["Title"] = "Forgot Password Sent";
    var email = TempData["ForgotEmail"] as string;
}

<section class="tg-auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
            <div class="col-md-6">
                <div class="card p-4 text-center">
                    <h3>Check your inbox</h3>

                    @if (!string.IsNullOrEmpty(email))
                    {
                        <p>If an account exists for <strong>@email</strong>, a password reset link has been sent.</p>
                    }
                    else
                    {
                        <p>If an account exists for the email you provided, a password reset link has been sent.</p>
                    }

                    <p class="text-muted">The link will expire in 60 minutes. If you don't see the email, check your spam folder.</p>

                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Back to Sign In</a>

                        @* Resend form: posts back to ForgotPassword action with prefilled email *@
                        <form asp-controller="Home" asp-action="ForgotPassword" method="post" class="d-inline-flex"
                            style="align-items:center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@email" />
                            <button type="submit" class="btn btn-outline-secondary">Resend Link</button>
                        </form>
                    </div>

                    <hr />

                    <p class="small text-center mt-3">Still having trouble? <a asp-controller="Home"
                            asp-action="Contact">Contact support</a> and we'll help you regain access to your account.</p>
                </div>
            </div>
        </div>
    </div>
</section>



