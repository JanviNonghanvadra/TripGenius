@{
    ViewData["Title"] = "Forgot Password";
}

<section class="tg-auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
            <div class="col-md-6">
                <div class="card p-4">
                    <h3>Forgot your password?</h3>
                    <p>Enter the email associated with your account and we'll send a reset link.</p>

                    @if (TempData["ForgotEmail"] != null)
                    {
                        <div class="alert alert-success">
                            A reset link has been sent to <strong>@TempData["ForgotEmail"]</strong> if that account exists. Check your inbox.
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-link">Back to Sign In</a>
                    }
                    else
                    {
                        <form asp-controller="Home" asp-action="ForgotPassword" method="post" id="forgotForm">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label class="form-label">Email address</label>
                                <input type="email" name="email" id="email" class="form-control" required />
                                <small class="form-text text-muted">We'll send a secure password reset link to this address.</small>
                            </div>

                            <button type="submit" class="btn btn-primary" id="sendBtn">Send reset link</button>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-link">Back to Sign In</a>
                        </form>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('forgotForm');
            if (!form) return;
            var email = document.getElementById('email');
            var sendBtn = document.getElementById('sendBtn');

            form.addEventListener('submit', function (e) {
                // basic client-side validation
                var atChar = String.fromCharCode(64);
                var re = new RegExp("\\S+" + atChar + "\\S+\\.\\S+");
                if (!email.value || !re.test(email.value)) {
                    e.preventDefault();
                    email.classList.add('is-invalid');
                    if (!document.querySelector('.invalid-feedback.email')) {
                        var f = document.createElement('div');
                        f.className = 'invalid-feedback email';
                        f.innerText = 'Please enter a valid email address.';
                        email.parentNode.appendChild(f);
                    }
                    return false;
                }

                // disable button to prevent double submit
                sendBtn.disabled = true;
                sendBtn.innerHTML = 'Sending...';
            });

            email.addEventListener('input', function () {
                email.classList.remove('is-invalid');
                var f = document.querySelector('.invalid-feedback.email');
                if (f) f.remove();
            });
        })();
    </script>
}



