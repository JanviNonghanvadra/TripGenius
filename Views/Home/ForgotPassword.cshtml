@{
    ViewData["Title"] = "Forgot Password";
}

<section class="tg-auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
            <div class="col-md-6">
                <div class="card p-4 shadow-sm">
                    <h3 class="mb-2">Forgot your password?</h3>
                    <p class="text-muted">
                        Enter your email and we’ll send a password reset link.
                    </p>

                    @if (TempData["ForgotEmail"] != null)
                    {
                        <div class="alert alert-success">
                            If an account exists for <strong>@TempData["ForgotEmail"]</strong>,
                            a reset link has been sent. Please check your inbox.
                        </div>

                        <a asp-controller="Account" asp-action="Login" class="btn btn-link">
                            Back to Sign In
                        </a>
                    }
                    else
                    {
                        <form asp-controller="Home" asp-action="ForgotPassword" method="post" id="forgotForm" novalidate>
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email address</label>

                                <input type="email"
                                       name="email"
                                       id="email"
                                       class="form-control"
                                       placeholder="Enter your email"
                                       required />

                                <div class="invalid-feedback">
                                    Please enter a valid email address.
                                </div>

                                <small class="form-text text-muted">
                                    We'll send a secure password reset link.
                                </small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100" id="sendBtn">
                                Send Reset Link
                            </button>

                            <div class="text-center mt-3">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-link">
                                    Back to Sign In
                                </a>
                            </div>
                        </form>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('forgotForm');
            if (!form) return;

            var email = document.getElementById('email');
            var sendBtn = document.getElementById('sendBtn');

            form.addEventListener('submit', function (e) {

                // HTML5 validation
                if (!email.checkValidity()) {
                    e.preventDefault();
                    email.classList.add('is-invalid');
                    return;
                }

                // disable button to prevent double submit
                sendBtn.disabled = true;
                sendBtn.innerHTML = 'Sending...';
            });

            email.addEventListener('input', function () {
                email.classList.remove('is-invalid');
            });
        })();
    </script>
}