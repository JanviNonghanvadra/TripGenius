@model List<TripGenius.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold text-success">My Bookings</h2>

    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Destination</th>
                        <th>Dates</th>
                        <th>People</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                🌍 @item.Trip?.Destination
                            </td>

                            <td>
                                <small>
                                    @item.Trip?.StartDate.ToString("dd MMM yyyy")
                                    <br />
                                    <span class="text-muted">to</span>
                                    <br />
                                    @item.Trip?.EndDate.ToString("dd MMM yyyy")
                                </small>
                            </td>

                            <td>
                                👤 @item.NumberOfPeople
                            </td>

                            <td class="fw-bold text-primary">
                                ₹ @item.TotalAmount
                            </td>

                            <td>
                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success px-3 py-2">Confirmed</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">Cancelled</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5 border rounded shadow-sm">
            <h4 class="text-muted">No bookings yet 😔</h4>
            <a href="/RegisterUser/Explore" class="btn btn-success mt-3">
                Explore Trips
            </a>
        </div>
    }
</div>