@model TripGenius.Models.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<section class="tg-page-hero tg-settings-hero">
    <div class="container">
        <div class="tg-ph-content">
            <span class="tg-section-badge">⚙️ Settings</span>
            <h1 class="tg-ph-title">Account Settings</h1>
            <p class="tg-ph-subtitle">Manage your account, preferences and security</p>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-12 mb-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                else if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
            </div>

            <div class="col-lg-3">
                <div class="tg-settings-nav">
                    <a href="#security" class="tg-sn-item active">
                        <i class="bi bi-shield-lock"></i> Security
                    </a>
                    <a href="#notifications" class="tg-sn-item">
                        <i class="bi bi-bell"></i> Notifications
                    </a>
                    <a href="#preferences" class="tg-sn-item">
                        <i class="bi bi-sliders"></i> Preferences
                    </a>
                    <a href="#privacy" class="tg-sn-item">
                        <i class="bi bi-eye-slash"></i> Privacy
                    </a>
                    <a href="#danger" class="tg-sn-item tg-sn-danger">
                        <i class="bi bi-exclamation-triangle"></i> Danger Zone
                    </a>
                </div>
            </div>

            <div class="col-lg-9">
                <!-- Security -->
                <div class="tg-settings-card mb-4" id="security">
                    <div class="tg-settings-card-header">
                        <h5><i class="bi bi-shield-lock-fill"></i> Security & Password</h5>
                    </div>
                    <div class="tg-settings-card-body">
                        <form method="post" asp-action="UpdatePassword" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="tg-form-label">Current Password</label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-lock-fill tg-input-icon"></i>
                                        <input asp-for="CurrentPassword" class="form-control tg-form-input" />
                                    </div>
                                    <span class="text-danger" asp-validation-for="CurrentPassword"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="tg-form-label">New Password</label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-key-fill tg-input-icon"></i>
                                        <input asp-for="NewPassword" class="form-control tg-form-input" />
                                    </div>
                                    <span class="text-danger" asp-validation-for="NewPassword"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="tg-form-label">Confirm New Password</label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-key tg-input-icon"></i>
                                        <input asp-for="ConfirmPassword" class="form-control tg-form-input" />
                                    </div>
                                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                                </div>
                            </div>

                            <div class="tg-password-strength mt-3">
                                <span class="tg-ps-label">Password Strength:</span>
                                <div class="tg-ps-bar"><div class="tg-ps-fill" style="width: 60%; background: #2f9e44;"></div></div>
                                <span class="tg-ps-text" style="color: #2f9e44;">Good</span>
                            </div>
                            <button type="submit" class="btn tg-btn-primary mt-3">Update Password</button>
                        </form>
                    </div>
                </div>

                <!-- Notifications -->
                <div class="tg-settings-card mb-4" id="notifications">
                    <div class="tg-settings-card-header">
                        <h5><i class="bi bi-bell-fill"></i> Notification Preferences</h5>
                    </div>
                    <div class="tg-settings-card-body">
                        <form method="post" asp-action="UpdateNotifications">
                            @Html.AntiForgeryToken()
                            <div class="tg-toggle-list">
                                <div class="tg-toggle-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="tg-toggle-title">Trip Reminders</span>
                                        <span class="tg-toggle-desc">Get notified before your upcoming trips</span>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="BookingConfirmations" class="form-check-input tg-toggle-switch" />
                                    </div>
                                </div>

                                <div class="tg-toggle-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="tg-toggle-title">New Destinations</span>
                                        <span class="tg-toggle-desc">Discover newly added travel spots</span>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="NewUserRegistration" class="form-check-input tg-toggle-switch" />
                                    </div>
                                </div>

                                <div class="tg-toggle-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="tg-toggle-title">Price Alerts</span>
                                        <span class="tg-toggle-desc">Be alerted when prices drop for saved trips</span>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="ReviewNotifications" class="form-check-input tg-toggle-switch" />
                                    </div>
                                </div>

                                <div class="tg-toggle-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="tg-toggle-title">Email Newsletter</span>
                                        <span class="tg-toggle-desc">Weekly travel tips and inspiration</span>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input asp-for="EmailNotifications" class="form-check-input tg-toggle-switch" />
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn tg-btn-primary mt-3">Save Notification Preferences</button>
                        </form>
                    </div>
                </div>

                <!-- Preferences -->
                <div class="tg-settings-card mb-4" id="preferences">
                    <div class="tg-settings-card-header">
                        <h5><i class="bi bi-sliders"></i> Travel Preferences</h5>
                    </div>
                    <div class="tg-settings-card-body">
                        <form method="post" asp-action="UpdatePreferences">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="tg-form-label">Preferred Currency</label>
                                    <select asp-for="Currency" class="form-select tg-form-input">
                                        <option value="INR">INR (₹)</option>
                                        <option value="USD">USD ($)</option>
                                        <option value="EUR">EUR (€)</option>
                                        <option value="GBP">GBP (£)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="tg-form-label">Language</label>
                                    <select asp-for="Language" class="form-select tg-form-input">
                                        <option value="en">English</option>
                                        <option value="hi">Hindi</option>
                                        <option value="fr">French</option>
                                        <option value="es">Spanish</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="tg-form-label">Travel Style</label>
                                    <select asp-for="TravelStyle" class="form-select tg-form-input">
                                        <option value="Budget">Budget</option>
                                        <option value="Standard">Standard</option>
                                        <option value="Luxury">Luxury</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="tg-form-label">Time Zone</label>
                                    <select asp-for="TimeZone" class="form-select tg-form-input">
                                        <option value="IST">IST (UTC+5:30)</option>
                                        <option value="UTC">UTC</option>
                                        <option value="EST">EST</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn tg-btn-primary mt-3">Save Preferences</button>
                        </form>
                    </div>
                </div>

                <!-- Privacy -->
                <div class="tg-settings-card mb-4" id="privacy">
                    <div class="tg-settings-card-header">
                        <h5><i class="bi bi-eye-slash-fill"></i> Privacy</h5>
                    </div>
                    <div class="tg-settings-card-body">
                        <p class="mb-3">We respect your privacy. Below are the key points about how TripGenius handles your personal information:</p>
                        <ul class="tg-privacy-list">
                            <li><strong>Data We Collect:</strong> Account details (name, email), profile info, trip and wishlist data, and usage/device information.</li>
                            <li><strong>How We Use Data:</strong> To provide and improve services, personalize recommendations, send notifications, and secure your account.</li>
                            <li><strong>Sharing:</strong> We do not sell personal data. We may share with service providers or when required by law.</li>
                            <li><strong>Your Rights:</strong> You can access, correct, export, or request deletion of your personal data.</li>
                            <li><strong>Cookies:</strong> We use essential, analytics, and preference cookies. You can control these via your browser settings.</li>
                        </ul>
                        <p class="mt-3">For the full privacy policy and contact details, view the complete document:</p>
                        <a asp-controller="RegisterUser" asp-action="Privacy" class="btn tg-btn-outline">Read Full Privacy Policy</a>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="tg-settings-card tg-danger-card" id="danger">
                    <div class="tg-settings-card-header">
                        <h5 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Danger Zone</h5>
                    </div>
                    <div class="tg-settings-card-body">
                        <div class="tg-danger-actions">
                            <div>
                                <span class="tg-toggle-title">Deactivate Account</span>
                                <span class="tg-toggle-desc d-block">Temporarily disable your account</span>
                            </div>
                            <form method="post" asp-action="DeactivateAccount">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn tg-btn-outline-danger">Deactivate</button>
                            </form>
                        </div>
                        <div class="tg-danger-actions mt-3">
                            <div>
                                <span class="tg-toggle-title">Delete Account</span>
                                <span class="tg-toggle-desc d-block">Permanently delete all your data. This cannot be undone.</span>
                            </div>
                            <form method="post" asp-action="DeleteAccount" onsubmit="return confirm('Are you sure you want to delete your account? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">Delete Account</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
document.addEventListener('DOMContentLoaded', function () {
    const nav = document.querySelector('.tg-settings-nav');
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll('.tg-sn-item'));

    function setActiveByHash() {
        const hash = window.location.hash || '#security';
        links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === hash));
    }

    // click highlights immediately and updates hash
    links.forEach(link => {
        link.addEventListener('click', function (e) {
            // allow default anchor behavior (scroll), but update active styling
            links.forEach(l => l.classList.remove('active'));
            this.classList.add('active');
        });
    });

    // update when hash changes (e.g. user uses back/forward)
    window.addEventListener('hashchange', setActiveByHash);

    // update on scroll to highlight the section currently near top of viewport
    const sectionElems = Array.from(document.querySelectorAll('.col-lg-9 [id]'));
    function onScroll() {
        let currentId = sectionElems.length ? sectionElems[0].id : null;
        for (const sec of sectionElems) {
            const rect = sec.getBoundingClientRect();
            if (rect.top <= 120) currentId = sec.id;
            else break;
        }
        if (currentId) {
            links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + currentId));
        }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // initial state
    setActiveByHash();
    // run once to set based on initial scroll position
    onScroll();
});
</script>
}




