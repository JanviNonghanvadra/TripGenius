@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="tg-page-hero tg-privacy-hero">
    <div class="container">
        <div class="tg-ph-content text-center">
            <span class="tg-section-badge"> Privacy</span>
            <h1 class="tg-ph-title">Privacy Policy</h1>
            <p class="tg-ph-subtitle">Last updated: January 1, 2025</p>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="tg-privacy-card">
                    <div class="tg-privacy-toc">
                        <h6 class="tg-privacy-toc-title">Table of Contents</h6>
                        <ol class="tg-privacy-toc-list">
                            <li><a href="#info-collect">Information We Collect</a></li>
                            <li><a href="#how-use">How We Use Your Information</a></li>
                            <li><a href="#sharing">Information Sharing</a></li>
                            <li><a href="#security">Data Security</a></li>
                            <li><a href="#rights">Your Rights</a></li>
                            <li><a href="#cookies">Cookies Policy</a></li>
                            <li><a href="#contact">Contact Us</a></li>
                        </ol>
                    </div>

                    <div class="tg-privacy-section" id="info-collect">
                        <h3 class="tg-privacy-heading"><i class="bi bi-database"></i> 1. Information We Collect</h3>
                        <p>At TripGenius, we collect information to provide you with the best travel planning experience. This includes:</p>
                        <ul class="tg-privacy-list">
                            <li><strong>Account Information:</strong> Your name, email address, and password when you create an account.</li>
                            <li><strong>Profile Information:</strong> Travel preferences, profile photo, phone number, and bio that you choose to provide.</li>
                            <li><strong>Trip Data:</strong> Destinations you search for, trips you plan, and places you save to your wishlist.</li>
                            <li><strong>Usage Data:</strong> How you interact with our platform including pages visited and features used.</li>
                            <li><strong>Device Information:</strong> IP address, browser type, and device identifiers for security purposes.</li>
                        </ul>
                    </div>

                    <div class="tg-privacy-section" id="how-use">
                        <h3 class="tg-privacy-heading"><i class="bi bi-gear"></i> 2. How We Use Your Information</h3>
                        <p>We use your information to:</p>
                        <ul class="tg-privacy-list">
                            <li>Provide, operate and improve our travel planning services.</li>
                            <li>Personalize your experience and recommend destinations based on your preferences.</li>
                            <li>Send you trip reminders, confirmations, and important service updates.</li>
                            <li>Respond to your requests and customer support queries.</li>
                            <li>Analyze usage patterns to improve our platform and develop new features.</li>
                            <li>Ensure the security and integrity of our platform.</li>
                        </ul>
                    </div>

                    <div class="tg-privacy-section" id="sharing">
                        <h3 class="tg-privacy-heading"><i class="bi bi-share"></i> 3. Information Sharing</h3>
                        <p>We do not sell your personal information. We may share your information with:</p>
                        <ul class="tg-privacy-list">
                            <li><strong>Travel Partners:</strong> Hotels, airlines, and tour operators only when needed to fulfill your bookings.</li>
                            <li><strong>Service Providers:</strong> Third-party companies that assist in operating our platform (payment processors, analytics).</li>
                            <li><strong>Legal Requirements:</strong> When required by law or to protect the rights and safety of users.</li>
                        </ul>
                    </div>

                    <div class="tg-privacy-section" id="security">
                        <h3 class="tg-privacy-heading"><i class="bi bi-shield-check"></i> 4. Data Security</h3>
                        <p>We implement industry-standard security measures to protect your data:</p>
                        <ul class="tg-privacy-list">
                            <li>All data is encrypted in transit using TLS/SSL technology.</li>
                            <li>Passwords are hashed using industry-standard bcrypt algorithms.</li>
                            <li>Regular security audits and penetration testing.</li>
                            <li>Strict access controls limiting who can access user data internally.</li>
                        </ul>
                    </div>

                    <div class="tg-privacy-section" id="rights">
                        <h3 class="tg-privacy-heading"><i class="bi bi-person-check"></i> 5. Your Rights</h3>
                        <p>You have the right to:</p>
                        <ul class="tg-privacy-list">
                            <li><strong>Access:</strong> Request a copy of the personal data we hold about you.</li>
                            <li><strong>Correction:</strong> Request that we correct inaccurate or incomplete data.</li>
                            <li><strong>Deletion:</strong> Request that we delete your personal data.</li>
                            <li><strong>Portability:</strong> Request your data in a machine-readable format.</li>
                            <li><strong>Objection:</strong> Object to processing of your data for marketing purposes.</li>
                        </ul>
                    </div>

                    <div class="tg-privacy-section" id="cookies">
                        <h3 class="tg-privacy-heading"><i class="bi bi-cookie"></i> 6. Cookies Policy</h3>
                        <p>We use cookies to enhance your browsing experience:</p>
                        <ul class="tg-privacy-list">
                            <li><strong>Essential Cookies:</strong> Required for the platform to function correctly.</li>
                            <li><strong>Analytical Cookies:</strong> Help us understand how users interact with our platform.</li>
                            <li><strong>Preference Cookies:</strong> Remember your settings and preferences.</li>
                        </ul>
                        <p>You can control cookies through your browser settings. Note that disabling some cookies may affect platform functionality.</p>
                    </div>

                    <div class="tg-privacy-section" id="contact">
                        <h3 class="tg-privacy-heading"><i class="bi bi-envelope"></i> 7. Contact Us</h3>
                        <p>If you have questions about this Privacy Policy or your data, contact us:</p>
                        <div class="tg-contact-info">
                            <div class="tg-ci-item"><i class="bi bi-envelope-fill"></i> privacy@tripgenius.com</div>
                            <div class="tg-ci-item"><i class="bi bi-telephone-fill"></i> +91 1800-TRIP-GEN</div>
                            <div class="tg-ci-item"><i class="bi bi-building"></i> TripGenius HQ, Rajkot, Gujarat, India</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>




