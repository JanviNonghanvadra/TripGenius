@{
    ViewData["Title"] = "Create Account";
}

<section class="tg-auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
            <div class="col-xl-10 col-lg-11">
                <div class="tg-auth-card">

                    <!-- Left decorative panel -->
                    <div class="tg-auth-left">
                        <div class="tg-auth-left-inner">
                            <div class="tg-auth-brand">
                                <i class="bi bi-compass-fill"></i>
                                <span>TripGenius</span>
                            </div>
                            <h2 class="tg-auth-left-title">Start Your Journey Today!</h2>
                            <p class="tg-auth-left-sub">Join 50, 000+ travelers who plan smarter, more memorable trips  completely free.</p>

                            <div class="tg-auth-perks">
                                <div class="tg-perk-item">
                                    <i class="bi bi-shield-check-fill"></i>
                                    <span>Free forever  no credit card needed</span>
                                </div>
                                <div class="tg-perk-item">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <span>Ready to explore in under 2 minutes</span>
                                </div>
                                <div class="tg-perk-item">
                                    <i class="bi bi-star-fill"></i>
                                    <span>Access exclusive travel deals & tips</span>
                                </div>
                                <div class="tg-perk-item">
                                    <i class="bi bi-bookmark-heart-fill"></i>
                                    <span>Save trips and revisit them anytime</span>
                                </div>
                            </div>

                            <img src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=500&h=220&fit=crop"
                                 class="tg-auth-left-img mt-auto" alt="Travel" />
                        </div>
                    </div>

                    <!-- Right form panel -->
                    <div class="tg-auth-right">
                        <div class="tg-auth-right-inner">
                            <h3 class="tg-auth-title">Create Account</h3>
                            <p class="tg-auth-subtitle">
                                Already have an account?
                                <a asp-controller="Account" asp-action="Login" class="tg-auth-link">Sign in</a>
                            </p>

                            <form id="regForm" asp-controller="Account" asp-action="Register" method="post" novalidate>
                                @Html.AntiForgeryToken()

                                <div id="serverErrors">
                                    @if (ViewData["RegErrors"] != null)
                                    {
                                        <div class="alert alert-danger">@Html.Raw(ViewData["RegErrors"].ToString())</div>
                                    }
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="tg-auth-field">
                                            <label class="tg-form-label">First Name <span class="text-danger">*</span></label>
                                            <div class="tg-input-group">
                                                <i class="bi bi-person tg-input-icon"></i>
                                                <input type="text" name="firstName" id="firstName" class="tg-form-input w-100"
                                                       placeholder="John" required />
                                            </div>
                                            <div class="tg-field-error d-none" id="firstErr">First name is required.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="tg-auth-field">
                                            <label class="tg-form-label">Last Name <span class="text-danger">*</span></label>
                                            <div class="tg-input-group">
                                                <i class="bi bi-person tg-input-icon"></i>
                                                <input type="text" name="lastName" id="lastName" class="tg-form-input w-100"
                                                       placeholder="Doe" required />
                                            </div>
                                            <div class="tg-field-error d-none" id="lastErr">Last name is required.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="tg-auth-field">
                                    <label class="tg-form-label">Email Address <span class="text-danger">*</span></label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-envelope tg-input-icon"></i>
                                        <input type="email" name="email" id="regEmail" class="tg-form-input w-100"
                                               placeholder="you@example.com" required autocomplete="email" />
                                    </div>
                                    <div class="tg-field-error d-none" id="emailErr">Please enter a valid email.</div>
                                </div>

                                <div class="tg-auth-field">
                                    <label class="tg-form-label">Phone Number</label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-telephone tg-input-icon"></i>
                                        <input type="tel" name="phone" id="phone" class="tg-form-input w-100"
                                               placeholder="+91 98765 43210" />
                                    </div>
                                </div>

                                <div class="tg-auth-field">
                                    <label class="tg-form-label">Password <span class="text-danger">*</span></label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-lock tg-input-icon"></i>
                                        <input type="password" name="password" id="regPassword"
                                               class="tg-form-input w-100"
                                               placeholder="Minimum 8 characters"
                                               required autocomplete="new-password" />
                                        <button type="button" class="tg-pw-toggle" onclick="togglePw('regPassword', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <!-- Strength bar -->
                                    <div class="tg-pw-strength mt-2" id="strengthWrap" style="display:none;">
                                        <div class="tg-pw-bar">
                                            <div id="strengthFill" class="tg-pw-fill"></div>
                                        </div>
                                        <small id="strengthText" class="tg-pw-text"></small>
                                    </div>
                                    <div class="tg-field-error d-none" id="passErr">Password must be at least 8 characters.</div>
                                </div>

                                <div class="tg-auth-field">
                                    <label class="tg-form-label">Confirm Password <span class="text-danger">*</span></label>
                                    <div class="tg-input-group">
                                        <i class="bi bi-lock-fill tg-input-icon"></i>
                                        <input type="password" name="confirmPassword" id="confirmPassword"
                                               class="tg-form-input w-100"
                                               placeholder="Repeat your password"
                                               required autocomplete="new-password" />
                                        <button type="button" class="tg-pw-toggle" onclick="togglePw('confirmPassword', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <small id="matchMsg" class="tg-pw-match-msg"></small>
                                    <div class="tg-field-error d-none" id="confirmErr">Passwords do not match.</div>
                                </div>

                                <div class="d-flex align-items-start gap-2 mb-4">
                                    <input type="checkbox" id="agreeTerms" name="agreeTerms" class="tg-checkbox mt-1" required />
                                    <label for="agreeTerms" class="tg-check-label">
                                        I agree to the <a href="#" class="tg-auth-link">Terms of Service</a>
                                        and <a asp-controller="RegisterUser" asp-action="Privacy" class="tg-auth-link">Privacy Policy</a>
                                    </label>
                                    <div class="tg-field-error d-none" id="termsErr">You must accept the Terms of Service.</div>
                                </div>

                                <button type="submit" class="btn tg-btn-auth-submit w-100">
                                    <i class="bi bi-person-plus-fill"></i> Create My Account
                                </button>
                            </form>

                            <p class="tg-auth-bottom-note mt-4">
                                Already have an account?
                                <a asp-controller="Account" asp-action="Login" class="tg-auth-link">Sign in here</a>
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    function togglePw(id, btn) {
        const inp = document.getElementById(id);
        const ico = btn ? btn.querySelector('i') : null;
        inp.type = inp.type === 'password' ? 'text' : 'password';
        if (ico) ico.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    }
    window.togglePw = togglePw; // expose for inline onclick

    // Elements
    const form = document.getElementById('regForm');
    const first = document.getElementById('firstName');
    const last = document.getElementById('lastName');
    const email = document.getElementById('regEmail');
    const phone = document.getElementById('phone');
    const pwInput = document.getElementById('regPassword');
    const confirmInput = document.getElementById('confirmPassword');
    const agree = document.getElementById('agreeTerms');

    const firstErr = document.getElementById('firstErr');
    const lastErr = document.getElementById('lastErr');
    const emailErr = document.getElementById('emailErr');
    const passErr = document.getElementById('passErr');
    const confirmErr = document.getElementById('confirmErr');
    const termsErr = document.getElementById('termsErr');
    const matchMsg = document.getElementById('matchMsg');

    // Password strength
    pwInput.addEventListener('input', function () {
        const v = this.value;
        const wrap = document.getElementById('strengthWrap');
        const fill = document.getElementById('strengthFill');
        const text = document.getElementById('strengthText');
        if (!v) { wrap.style.display = 'none'; passErr.classList.add('d-none'); return; }
        wrap.style.display = 'flex';
        let score = 0;
        if (v.length >= 8) score++;
        if (/[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        const levels = [
            { label: 'Very Weak', color: '#dc3545', width: '20%' }, { label: 'Weak', color: '#fd7e14', width: '40%' }, { label: 'Fair', color: '#ffc107', width: '60%' }, { label: 'Good', color: '#20c997', width: '80%' }, { label: 'Strong', color: '#28a745', width: '100%' }];
        const l = levels[score] || levels[0];
        fill.style.width = l.width;
        fill.style.background = l.color;
        text.textContent = l.label;
        text.style.color = l.color;
        // password length validation
        if (v.length < 8) {
            passErr.classList.remove('d-none');
        } else {
            passErr.classList.add('d-none');
        }
        checkMatch();
    });

    confirmInput.addEventListener('input', checkMatch);
    function checkMatch() {
        if (!confirmInput.value) { matchMsg.textContent = ''; confirmErr.classList.add('d-none'); return; }
        if (pwInput.value === confirmInput.value) {
            matchMsg.innerHTML = '<span style="color:#28a745"><i class="bi bi-check-circle-fill"></i> Passwords match</span>';
            confirmErr.classList.add('d-none');
        } else {
            matchMsg.innerHTML = '<span style="color:#dc3545"><i class="bi bi-x-circle-fill"></i> Passwords do not match</span>';
            confirmErr.classList.remove('d-none');
        }
    }

    // Simple email regex
    const atChar = String.fromCharCode(64);
    const emailRegex = new RegExp("\\S+" + atChar + "\\S+\\.\\S+");

    form.addEventListener('submit', function (e) {
        // reset
        firstErr.classList.add('d-none');
        lastErr.classList.add('d-none');
        emailErr.classList.add('d-none');
        passErr.classList.add('d-none');
        confirmErr.classList.add('d-none');
        termsErr.classList.add('d-none');

        let valid = true;
        if (!first.value.trim()) { firstErr.classList.remove('d-none'); valid = false; }
        if (!last.value.trim()) { lastErr.classList.remove('d-none'); valid = false; }
        if (!email.value || !emailRegex.test(email.value)) { emailErr.classList.remove('d-none'); valid = false; }
        if (!pwInput.value || pwInput.value.length < 8) { passErr.classList.remove('d-none'); valid = false; }
        if (pwInput.value !== confirmInput.value) { confirmErr.classList.remove('d-none'); valid = false; }
        if (!agree.checked) { termsErr.classList.remove('d-none'); valid = false; }

        if (!valid) {
            e.preventDefault();
            return false;
        }

        // allow form to submit to server for server-side validation
    });
});
</script>
}



