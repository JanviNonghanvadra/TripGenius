@model List<TripGenius.Models.Trip>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Trips";
    ViewData["ActivePage"] = "Trips";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h2>Trip Management</h2>
            <p>Manage and monitor all travel packages</p>
        </div>
        <a asp-action="AddTrip" class="btn-primary-action">
            <i class="fas fa-plus"></i> Add Trip
        </a>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon trips"><i class="fas fa-globe"></i></div>
            <div class="stat-body"><h3>@ViewBag.TotalTrips</h3><span>Total Trips</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon active"><i class="fas fa-check-circle"></i></div>
            <div class="stat-body"><h3>@ViewBag.ActiveTrips</h3><span>Active</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon pending"><i class="fas fa-pause-circle"></i></div>
            <div class="stat-body"><h3>@ViewBag.InactiveTrips</h3><span>Inactive</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue"><i class="fas fa-star"></i></div>
            <div class="stat-body"><h3>@(ViewBag.AvgRating ?? "0.0")</h3><span>Avg Rating</span></div>
        </div>
    </div>

    <div class="card">
        <form method="get" class="filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search trips..." />
            </div>

            <select name="status" class="filter-select" onchange="this.form.submit()">
                <option value="">All Status</option>
                <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Active</option>
                <option value="Inactive" selected="@(Context.Request.Query["status"] == "Inactive")">Inactive</option>
            </select>

            <button type="submit" class="btn-filter">
                <i class="fas fa-filter"></i> Filter
            </button>
        </form>

        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Trip</th>
                        <th>Price</th>
                        <th>Start Date</th>   <!-- ? NEW -->
                        <th>End Date</th>     <!-- ? NEW -->
                        <th>Bookings</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var t in Model)
                    {
                        var avgRating = t.Reviews != null && t.Reviews.Any()
                        ? t.Reviews.Average(r => r.Rating).ToString("0.1")
                        : "";

                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="avatar trip-avatar">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <div>
                                        <strong>@t.Title</strong>
                                        <div class="sub-text">
                                            <i class="fas fa-location-dot"></i> @t.Destination
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <strong class="price-tag">@t.Price.ToString("N0")</strong>
                            </td>

                            <!-- ? START DATE -->
                            <td>
                                @t.StartDate.ToString("dd/MM/yyyy")
                            </td>

                            <!-- ? END DATE -->
                            <td>
                                @t.EndDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(t.Bookings?.Count ?? 0)
                            </td>

                            <td>
                                @if (avgRating != "")
                                {
                                    <span class="star-rating">@avgRating</span>
                                }
                                else
                                {
                                    <span class="sub-text">No reviews</span>
                                }
                            </td>

                            <td>
                                <span class="badge-status @t.Status.ToLower()">@t.Status</span>
                            </td>

                            <td>
                                <div class="action-group">
                                    <a asp-action="EditTrip" asp-route-id="@t.Id"
                                       class="action-btn edit-btn" title="Edit">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <form asp-action="DeleteTrip" method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('Delete trip: @t.Title?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="action-btn delete-btn" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="empty-td">
                                <i class="fas fa-map"></i> No trips found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if ((int)(ViewBag.TotalPages ?? 0) > 1)
        {
            <div class="pagination">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <a href="?page=@i&search=@Context.Request.Query["search"]&status=@Context.Request.Query["status"]"
                       class="page-btn @(ViewBag.CurrentPage == i ? "active" : "")">
                        @i
                    </a>
                }
            </div>
        }
    </div>
</div>