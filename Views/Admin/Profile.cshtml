@model TripGenius.Models.User
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["ActivePage"] = "Settings";
    ViewData["Title"] = "My Profile";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h2>My Profile</h2>
            <p>View and manage your admin account information</p>
        </div>
        <a asp-controller="Admin" asp-action="ChangePassword" class="btn-secondary-action">
            <i class="fas fa-key"></i> Change Password
        </a>
    </div>

    <div class="profile-layout">
        <!-- LEFT: Profile Card -->
        <div class="profile-sidebar">
            <div class="profile-avatar-large">
                @(string.IsNullOrEmpty(Model?.Name) ? "A" : Model.Name.Substring(0, 1).ToUpper())
            </div>
            <h3>@(Model?.Name ?? "Admin User")</h3>
            <span class="profile-role">@(Model?.Role ?? "Administrator")</span>

            <div class="profile-meta">
                <div class="profile-meta-item">
                    <label><i class="fas fa-envelope" style="margin-right:4px;color:#5a8a00;"></i> Email</label>
                    <span>@(Model?.Email ?? "Not set")</span>
                </div>
                <div class="profile-meta-item">
                    <label><i class="fas fa-phone" style="margin-right:4px;color:#5a8a00;"></i> Phone</label>
                    <span>@(string.IsNullOrEmpty(Model?.Phone) ? "Not set" : Model.Phone)</span>
                </div>
                <div class="profile-meta-item">
                    <label><i class="fas fa-calendar" style="margin-right:4px;color:#5a8a00;"></i> Member Since</label>
                    <span>@(Model?.CreatedAt.ToString("MMMM dd, yyyy") ?? "")</span>
                </div>
            </div>
        </div>

        <!-- RIGHT: Edit Form -->
        <div class="profile-content">
            <h4><i class="fas fa-user-edit" style="color:#5a8a00;margin-right:8px;"></i> Edit Profile Information</h4>

            @if (TempData["ProfileSaved"] != null)
            {
                <div class="alert-success-inline">
                    <i class="fas fa-check-circle"></i> @TempData["ProfileSaved"]
                </div>
            }

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                @if (Model != null)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="form-group" style="margin-bottom:20px;">
                    <label asp-for="Name"><i class="fas fa-user"></i> Full Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="form-group" style="margin-bottom:20px;">
                    <label><i class="fas fa-envelope"></i> Email Address</label>
                    <input class="form-control" value="@Model?.Email" disabled style="background:#f5f5f5;cursor:not-allowed;" />
                    <span style="font-size:12px;color:#aaa;">Email cannot be changed here.</span>
                </div>

                <div class="form-group" style="margin-bottom:30px;">
                    <label asp-for="Phone"><i class="fas fa-phone"></i> Phone Number</label>
                    <input asp-for="Phone" class="form-control" placeholder="Enter your phone number" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>

                <div style="text-align:right;">
                    <button type="submit" class="btn-primary-action">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }




