@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = "Settings";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h2>Change Password</h2>
            <p>Update your account security credentials</p>
        </div>
        <a asp-controller="Admin" asp-action="Profile" class="btn-secondary-action">
            <i class="fas fa-arrow-left"></i> Back to Profile
        </a>
    </div>

    <div class="card form-card">
        @if (TempData["PasswordChanged"] != null)
        {
            <div class="alert-success-inline" style="margin-bottom:20px;">
                <i class="fas fa-check-circle"></i> @TempData["PasswordChanged"]
            </div>
        }

        <div asp-validation-summary="All" class="field-error" style="margin-bottom:16px;background:#fce4ec;padding:12px 16px;border-radius:10px;border-left:4px solid #c62828;"></div>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group" style="margin-bottom:20px;">
                <label for="currentPassword"><i class="fas fa-lock" style="color:#5a8a00;"></i> Current Password</label>
                <input type="password" id="currentPassword" name="currentPassword" class="form-control" placeholder="Enter current password" required />
            </div>

            <div class="form-group" style="margin-bottom:20px;">
                <label for="newPassword"><i class="fas fa-key" style="color:#5a8a00;"></i> New Password</label>
                <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Enter new password (min 6 chars)" required />
            </div>

            <div class="form-group" style="margin-bottom:30px;">
                <label for="confirmPassword"><i class="fas fa-check-circle" style="color:#5a8a00;"></i> Confirm New Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Re-enter new password" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary-action">
                    <i class="fas fa-key"></i> Update Password
                </button>
                <a asp-action="Profile" class="btn-secondary-action">Cancel</a>
            </div>
        </form>
    </div>
</div>



