@model TripGenius.Models.Trip
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["ActivePage"] = "Trips";
    ViewData["Title"] = "Add Trip";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h2>Add New Trip</h2>
            <p>Create a new travel package</p>
        </div>
        <a asp-action="Trips" class="btn-secondary-action">
            <i class="fas fa-arrow-left"></i> Back to Trips
        </a>
    </div>

    <div class="card form-card">
        <form asp-action="AddTrip" method="post">
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="form-group">
                    <label><i class="fas fa-tag"></i> Trip Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Bali Adventure Package" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-location-dot"></i> Destination</label>
                    <input asp-for="Destination" class="form-control" placeholder="e.g. Bali, Indonesia" />
                    <span asp-validation-for="Destination" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-indian-rupee-sign"></i> Price</label>
                    <input asp-for="Price" class="form-control" placeholder="e.g. 25000" />
                    <span asp-validation-for="Price" class="field-error"></span>
                </div>

                <!-- ? REMOVED DurationDays -->
                <!-- ? START DATE -->
                <div class="form-group">
                    <label><i class="fas fa-calendar-plus"></i> Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="field-error"></span>
                </div>

                <!-- ? END DATE -->
                <div class="form-group">
                    <label><i class="fas fa-calendar-check"></i> End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-image"></i> Image URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="Paste image URL" />
                </div>

                <div class="form-group">
                    <label><i class="fas fa-toggle-on"></i> Status</label>
                    <select asp-for="Status" class="form-control">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="form-group full-width">
                <label><i class="fas fa-align-left"></i> Description</label>
                <textarea asp-for="Description" rows="4" class="form-control"
                          placeholder="Describe the trip details, highlights, inclusions..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary-action">
                    <i class="fas fa-plus"></i> Save Trip
                </button>
                <a asp-action="Trips" class="btn-secondary-action">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}