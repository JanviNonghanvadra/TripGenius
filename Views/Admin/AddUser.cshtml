@model TripGenius.Models.ViewModels.AddUserViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["ActivePage"] = "Users";
    ViewData["Title"] = "Add User";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h2>Add New User</h2>
            <p>Create a new user account</p>
        </div>
        <a asp-action="Users" class="btn-secondary-action"><i class="fas fa-arrow-left"></i> Back to Users</a>
    </div>

    <div class="card form-card">
        <form asp-action="AddUser" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="FullName"><i class="fas fa-user"></i> Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email"><i class="fas fa-envelope"></i> Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"><i class="fas fa-lock"></i> Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Role"><i class="fas fa-user-tag"></i> Role</label>
                    <select asp-for="Role" class="form-control">
                        <option value="User">User</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Status"><i class="fas fa-toggle-on"></i> Status</label>
                    <select asp-for="Status" class="form-control">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary-action"><i class="fas fa-plus"></i> Create User</button>
                <a asp-action="Users" class="btn-secondary-action">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }



