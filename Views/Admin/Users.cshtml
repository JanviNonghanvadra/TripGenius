@model List<TripGenius.Models.ViewModels.UserViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
    ViewData["ActivePage"] = "Users";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <h2>User Management</h2>
            <p>Manage and monitor all registered users</p>
        </div>
        <a asp-controller="Admin" asp-action="AddUser" class="btn-primary-action">
            <i class="fas fa-plus"></i> Add User
        </a>
    </div>

    <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon users"><i class="fas fa-users"></i></div><div class="stat-body"><h3>@ViewBag.TotalUsers</h3><span>Total Users</span></div></div>
        <div class="stat-card"><div class="stat-icon active"><i class="fas fa-user-check"></i></div><div class="stat-body"><h3>@ViewBag.ActiveUsers</h3><span>Active</span></div></div>
        <div class="stat-card"><div class="stat-icon trips"><i class="fas fa-user-tag"></i></div><div class="stat-body"><h3>@ViewBag.RegisteredUsers</h3><span>Customers</span></div></div>
        <div class="stat-card"><div class="stat-icon revenue"><i class="fas fa-user-plus"></i></div><div class="stat-body"><h3>@ViewBag.NewThisMonth</h3><span>New This Month</span></div></div>
    </div>

    <div class="card">
        <form method="get" class="filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search users..." />
            </div>
            <select name="role" class="filter-select">
                <option value="">All Roles</option>
                <option value="User" selected="@(Context.Request.Query["role"] == "User")">User</option>
<option value="Admin" selected="@(Context.Request.Query["role"] == "Admin")">Admin</option>

                @* <option value="User"  @(Context.Request.Query["role"] == "User"  ? "selected" : "")>User</option>
                <option value="Admin" @(Context.Request.Query["role"] == "Admin" ? "selected" : "")>Admin</option> *@
            </select>
            <select name="status" class="filter-select">
                <option value="">All Status</option>
                <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Active</option>
                    <option value="Inactive" selected="@(Context.Request.Query["status"] =="Inactive" )">Inactive</option>
                @* <option value="Active"   @(Context.Request.Query["status"] == "Active"   ? "selected" : "")>Active</option>
                <option value="Inactive" @(Context.Request.Query["status"] == "Inactive" ? "selected" : "")>Inactive</option> *@
            </select>
            <button type="submit" class="btn-filter"><i class="fas fa-filter"></i> Filter</button>
        </form>

        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Phone</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="avatar">@user.Name[0]</div>
                                        <div>
                                            <strong>@user.Name</strong>
                                            <div class="sub-text">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="role-badge @(user.Role == "Admin" ? "admin" : "user")">@user.Role</span>
                                </td>
                                <td>
                                    <span class="badge-status @(user.Status == "Active" ? "confirmed" : "cancelled")">@user.Status</span>
                                </td>
                                <td>@(string.IsNullOrEmpty(user.Phone) ? "" : user.Phone)</td>
                                <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="action-group">
                                        <form asp-action="ToggleUserStatus" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="action-btn @(user.Status == "Active" ? "warn-btn" : "ok-btn")" title="@(user.Status == "Active" ? "Deactivate" : "Activate")">
                                                <i class="fas @(user.Status == "Active" ? "fa-toggle-off" : "fa-toggle-on")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteUser" method="post" style="display:inline;" onsubmit="return confirm('Delete user @user.Name?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="action-btn delete-btn" title="Delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="empty-td"><i class="fas fa-users-slash"></i> No users found.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if ((int)(ViewBag.TotalPages ?? 0) > 1)
        {
            <div class="pagination">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <a href="?page=@i&search=@Context.Request.Query["search"]&role=@Context.Request.Query["role"]&status=@Context.Request.Query["status"]"
                       class="page-btn @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
                }
            </div>
        }
    </div>
</div>



