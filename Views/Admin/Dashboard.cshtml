    <!-- RECENT BOOKINGS -->
    <div class="card">
        <div class="card-head">
            <div>
                <h3>Recent Bookings</h3>
                <p class="card-subtitle">Latest customer reservations</p>
            </div>
            <a asp-controller="Admin" asp-action="Bookings" class="view-all-link">View All <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Destination</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var b in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="avatar">@(string.IsNullOrEmpty(b.CustomerName) ? "-" : b.CustomerName[0].ToString())</div>
                                        <strong>@b.CustomerName</strong>
                                    </div>
                                </td>
                                <td>@b.TripName</td>
                                <td>@b.BookingDate.ToString("MMM dd, yyyy")</td>
                                <td><strong>@b.Amount.ToString("N0")</strong></td>
                                <td><span class="badge-status @b.Status.ToLower()">@b.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="empty-td">No recent bookings.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>




