@section Scripts {
    <script>
        const chartMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartMonths ?? new string[] { }));
        const chartRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartRevenue ?? new decimal[] { }));
        const chartBookings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartBookings ?? new int[] { }));
        const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryLabels ?? new string[] { }));
        const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryData ?? new int[] { }));
    </script>
}

<div class="admin-page">
    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h2>Dashboard</h2>
            <p>Welcome back, @(ViewBag.AdminName ?? "Admin")! Here's what's happening today.</p>
        </div>
        <div class="header-date">
            <i class="fas fa-calendar-alt"></i>
            <span>@DateTime.Now.ToString("MMMM dd, yyyy")</span>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="quick-actions">
        <a asp-controller="Admin" asp-action="Users"    class="quick-card"><i class="fas fa-users"></i><span>Users</span></a>
        <a asp-controller="Admin" asp-action="Trips"    class="quick-card"><i class="fas fa-map-marked-alt"></i><span>Trips</span></a>
        <a asp-controller="Admin" asp-action="Bookings" class="quick-card"><i class="fas fa-calendar-check"></i><span>Bookings</span></a>
        <a asp-controller="Admin" asp-action="Payments" class="quick-card"><i class="fas fa-credit-card"></i><span>Payments</span></a>
    </div>

    <!-- STATS GRID -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon users"><i class="fas fa-users"></i></div>
            <div class="stat-body">
                <h3>@(ViewBag.UserCount ?? 0)</h3>
                <span>Total Users</span>
                <p class="stat-delta positive"><i class="fas fa-arrow-up"></i> +12.5%</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon trips"><i class="fas fa-map-marked-alt"></i></div>
            <div class="stat-body">
                <h3>@(ViewBag.TripsCount ?? 0)</h3>
                <span>Active Trips</span>
                <p class="stat-delta positive"><i class="fas fa-arrow-up"></i> +8.2%</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bookings"><i class="fas fa-calendar-check"></i></div>
            <div class="stat-body">
                <h3>@(ViewBag.BookingCount ?? 0)</h3>
                <span>Total Bookings</span>
                <p class="stat-delta positive"><i class="fas fa-arrow-up"></i> +23.1%</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue"><i class="fas fa-indian-rupee-sign"></i></div>
            <div class="stat-body">
                <h3>@String.Format("{0:N0}", ViewBag.Revenue ?? 0)</h3>
                <span>Total Revenue</span>
                <p class="stat-delta positive"><i class="fas fa-arrow-up"></i> +15.3%</p>
            </div>
        </div>
    </div>

    <!-- CHARTS -->
    <div class="charts-grid">
        <div class="card chart-card">
            <div class="card-head">
                <h3>Revenue & Bookings</h3>
                <span class="card-badge">Last 6 months</span>
            </div>
            <div class="chart-container">
                <canvas id="lineChart"></canvas>
            </div>
        </div>
        <div class="card chart-card">
            <div class="card-head">
                <h3>Trip Categories</h3>
                <span class="card-badge">Distribution</span>
            </div>
            <div class="chart-container pie-container">
                <canvas id="pieChart"></canvas>
            </div>
        </div>
    </div>
