@model List<TripGenius.Models.ViewModels.BookingViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}
<style>    /* Update these specific parts in your admin.css */

    .charts-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr; /* Gives more room to the line chart */
        gap: 20px;
        margin-bottom: 24px;
        align-items: stretch;
    }

    .chart-container {
        position: relative;
        height: 300px; /* Fixed height ensures stability */
        width: 100%;
    }

    /* Pie charts look best when slightly smaller than line charts */
    .pie-container {
        height: 280px;
        margin: 0 auto;
    }

    .chart-card {
        display: flex;
        flex-direction: column;
    }

    .card-head {
        flex-shrink: 0; /* Prevents header from squishing */
    }</style>
